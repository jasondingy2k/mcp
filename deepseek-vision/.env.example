# deepseek-vision 环境变量（本文件仅为示例/文档；真实 key 建议由 CC Switch 的 MCP 配置 env 注入）
# 复制为 .env 可被启动时加载（支持 export 前缀、# 注释、非法值跳过，只在启动时加载一次）

# OpenCode Go API key（必填；缺省时工具会返回设置指引）
OPENCODE_API_KEY=
# 兼容别名
# VISION_API_KEY=

# 可选：OpenCode Go 兼容端点（默认 https://opencode.ai/zen/go/v1）
VISION_BASE_URL=

# 可选：模型名（默认 mimo-v2.5）
VISION_MODEL_NAME=

# 可选：最大完成 token 数（含 reasoning，默认 4096，下限 512）
VISION_MAX_TOKENS=

# 可选：图片大小上限字节（默认 20MB）
VISION_MAX_IMAGE_BYTES=

# 可选：图片像素上限（宽×高，默认 40000000）
VISION_MAX_IMAGE_PIXELS=

# 可选：sharp 全量解码超时毫秒（默认 15000）
VISION_VERIFY_TIMEOUT_MS=

# 可选：模型名兼容别名（优先 VISION_MODEL_NAME）
# VISION_MODEL=

# 可选：诊断日志级别 debug|info|warn|error；缺省为静默
DEEPSEEK_VISION_LOG_LEVEL=
