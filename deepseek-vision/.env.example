# deepseek-vision 环境变量（本文件仅为示例/文档；真实 key 建议由 CC Switch 的 MCP 配置 env 注入）
# 复制为 .env 可被启动时加载（支持 export 前缀、# 注释、非法值跳过，只在启动时加载一次）

# 主池 API key（必填其一：主池或备用池；缺省时工具会返回设置指引）
# 同池多 key：逗号分隔，等权轮询；鉴权/429/额度失败换下一个
# 例 Google：OPENCODE_API_KEY=AIza…,AIza…
OPENCODE_API_KEY=
# 兼容别名
# VISION_API_KEY=

# 主池端点 / 模型（默认 OpenCode Go；Google：…/v1beta/openai/ + gemini-3.1-flash-lite）
VISION_BASE_URL=
VISION_MODEL_NAME=

# 备用池：主池全部可换号失败后再用（例 Groq 双 key）
# VISION_FALLBACK_API_KEY=gsk_xxx,gsk_yyy
# VISION_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# VISION_FALLBACK_MODEL_NAME=qwen/qwen3.6-27b
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_BASE_URL=
VISION_FALLBACK_MODEL_NAME=

# 可选：主池单次探测超时 ms（有 fallback 时生效，默认 20000；阻断时尽快切备用）
# VISION_PRIMARY_PROBE_TIMEOUT_MS=20000

# 可选：reasoning_effort（默认 none=关 thinking 且省略字段；default=开）
VISION_REASONING_EFFORT=none
# 可选：reasoning_effort 发送策略（auto|supported|unsupported；默认 auto）
# VISION_REASONING_EFFORT_CAPABILITY=auto
# VISION_FALLBACK_REASONING_EFFORT_CAPABILITY=auto

# 可选：最大完成 token 数（含 reasoning，默认 4096，下限 512）
VISION_MAX_TOKENS=

# 可选：图片大小上限字节（默认 20MB）
VISION_MAX_IMAGE_BYTES=

# 可选：图片像素上限（宽×高，默认 40000000）
VISION_MAX_IMAGE_PIXELS=

# 可选：sharp 全量解码超时毫秒（默认 15000）
VISION_VERIFY_TIMEOUT_MS=

# 可选：送模前最长边缩放上限像素（默认 2048；0=禁用）
VISION_MAX_SEND_EDGE=

# 可选：送模输出编码（auto|png|jpeg|webp，默认 auto）
# auto：JPEG/WebP/HEIC 照片→JPEG；PNG/截图/含 alpha→PNG。webp 仅显式启用
# VISION_OUTPUT_FORMAT=auto
# 可选：JPEG/WebP 质量 1–100（默认 90）
# VISION_OUTPUT_QUALITY=90

# 可选：模型名兼容别名（优先 VISION_MODEL_NAME）
# VISION_MODEL=

# 可选：诊断日志级别 debug|info|warn|error；缺省为静默
DEEPSEEK_VISION_LOG_LEVEL=
