# deepseek-websearch 环境变量（本文件仅为示例/文档；真实 key 建议由 CC Switch 的 MCP 配置 env 注入）
# 复制为 .env 可被启动时加载（支持 export 前缀、# 注释、非法值跳过，只在启动时加载一次）

# Tavily API key（一个或多个，逗号分隔，如 tvly-a,tvly-b）。缺省时进入 keyless 模式：仅 deepseek_search / deepseek_extract 可用
TAVILY_API_KEY=

# 可选：Exa API key（一个或多个，逗号分隔，如 exa-1,exa-2）。deepseek_search 按权重在 Tavily/Exa 池中选 key，
# 单次请求内失败（含 401/402/429）会换池中下一 key；extract/crawl/map 仅用 Tavily 池。缺省则只用 Tavily。
EXA_API_KEY=

# 可选：Exa 别名（仅当 EXA_API_KEY 为空时使用，同样逗号解析）
EXASEARCH_API_KEY=

# 可选：多 key 加权轮询权重（正整数）。默认 Tavily=1000、Exa=1400（按免费额度比例校准）；额度变更时用 env 覆盖，不改代码
TAVILY_KEY_WEIGHT=
EXA_KEY_WEIGHT=

# 可选：请求归因用 Human ID
TAVILY_HUMAN_ID=

# 可选：工具参数默认值（JSON 字符串），如 {"search_depth":"advanced","include_images":true}
DEFAULT_PARAMETERS=

# 可选：research 主代理 LLM key。deepseek_research 用主代理规划（先广后深）+ Tavily/Exa basic 搜索 + 综合报告，
# 成本 5–10 点封顶（替代官方 /research 动态 15–250 点）。与 deepseek-vision 独立，仅认本变量。
RESEARCH_API_KEY=

# 可选：主代理端点（OpenAI 兼容）。默认 https://opencode.ai/zen/go/v1
RESEARCH_BASE_URL=

# 可选：主代理模型（默认 deepseek-v4-flash，2026-07-31 后训练 0731 正式版）
RESEARCH_MODEL=

# 可选：总搜索次数下限/上限、广度/深度下限（默认 5 / 10 / 3 / 2）
RESEARCH_MIN_SEARCHES=
RESEARCH_MAX_SEARCHES=
RESEARCH_MIN_BREADTH=
RESEARCH_MIN_DEPTH=

# 可选：诊断日志级别 debug|info|warn|error；缺省为静默（不输出任何日志）
DEEPSEEK_WEBSEARCH_LOG_LEVEL=
